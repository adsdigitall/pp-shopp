{
  "name": "pp-shopp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:api": "node server/index.mjs",
    "worker": "node server/worker.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/shopee.test.mjs",
    "test:all": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.typed.config.mjs ."
  },
  "dependencies": {
