# Painel temporário no IP. Troque por HTTPS quando apontar um domínio.
PUBLIC_APP_URL=http://SEU_IP
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
LOCAL_ADMIN_EMAIL=seu-email@exemplo.com
LOCAL_ADMIN_PASSWORD=troque-por-uma-senha-forte
LOCAL_ADMIN_USER_ID=default_user

SHOPEE_APP_ID=
SHOPEE_SECRET=
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=jarvis

# Não definir SUPABASE_URL nem SUPABASE_SERVICE_ROLE_KEY: a VPS grava em /app/data.
