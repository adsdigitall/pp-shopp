# ==============================================================
# Shopee Affiliate API - CREDENCIAIS SERVER-SIDE ONLY
# ==============================================================
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite .env.local. Nunca exponha estas variaveis ao frontend.
# Elas sao lidas APENAS pelo backend (server/), nunca pelo bundle JS.
# --------------------------------------------------------------

# App ID fornecido pela Shopee no painel Open API de afiliados
SHOPEE_APP_ID=

# Secret fornecido pela Shopee (usado apenas para assinar requests no servidor)
SHOPEE_SECRET=

# --------------------------------------------------------------
# Opcionais (defaults ja definidos no servidor)
# --------------------------------------------------------------

# Endpoint oficial da Shopee Affiliate Open API (Brasil, GraphQL)
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# Timeout (ms) das chamadas feitas ao servidor Shopee
SHOPEE_TIMEOUT_MS=10000

# ==============================================================
# Mercado Livre API - CREDENCIAIS SERVER-SIDE ONLY
# ==============================================================
# Crie um app em https://developers.mercadolivre.com.br/
# Configure Redirect URI: http://localhost:8787/api/mercadolivre/callback
# (ou sua URL de produção)
# --------------------------------------------------------------

# Client ID (App ID) do seu aplicativo no Mercado Livre Developers
MERCADO_LIVRE_CLIENT_ID=

# Client Secret do seu aplicativo
MERCADO_LIVRE_CLIENT_SECRET=

# URI de redirect configurada no app (deve ser igual à cadastrada)
# Ex: http://localhost:8787/api/mercadolivre/callback
MERCADO_LIVRE_REDIRECT_URI=http://localhost:8787/api/mercadolivre/callback

# Site ID (MLB = Brasil, MLA = Argentina, etc.)
MERCADO_LIVRE_SITE_ID=MLB

# --------------------------------------------------------------
# Provedores de Link Afiliado (OPCIONAIS)
# --------------------------------------------------------------
# Como o ML não tem API oficial pública de afiliados, você pode
# configurar provedores terceiros autorizados:

# Bot do Afiliado (https://botdoafiliado.com)
BOT_DO_AFILIADO_API_KEY=

# AfiliTools (https://afilitools.com.br)
AFILITOOLS_API_KEY=

# Afilimax - usa cookies de sessão (configurar via painel)
# AFILIMAX_COOKIES_JSON=

# --------------------------------------------------------------
# Chave OpenAI (somente backend; usada para gerar artes personalizadas)
# --------------------------------------------------------------
OPENAI_API_KEY=

# --------------------------------------------------------------
# Push de vendas (VAPID; somente backend)
# --------------------------------------------------------------
VAPID_SUBJECT=mailto:seu-email@exemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --------------------------------------------------------------
# Porta do backend interno
# --------------------------------------------------------------
PORT=8787

# ==============================================================
# Supabase (backend only)
# ==============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
